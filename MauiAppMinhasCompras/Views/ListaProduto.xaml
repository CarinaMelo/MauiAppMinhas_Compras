<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="MauiAppMinhasCompras.Views.ListaProduto"
    Title="Minhas Compras">

    <ContentPage.ToolbarItems>

        <ToolbarItem
            Text="Somar"
            Clicked="ToolbarItem_Clicked_1" />

        <ToolbarItem
            Text="Adicionar"
            Clicked="ToolbarItem_Clicked" />

    </ContentPage.ToolbarItems>

    <VerticalStackLayout
        Padding="10"
        Spacing="10">

        <!-- Campo de pesquisa -->
        <SearchBar
            x:Name="txt_search"
            Placeholder="Buscar produto..."
            TextChanged="txt_search_TextChanged" />

        <!-- Lista de produtos -->
        <RefreshView
            x:Name="refreshView"
            Refreshing="lst_produtos_Refreshing">

            <ListView
                x:Name="lst_produtos"
                HasUnevenRows="True"
                ItemSelected="lst_produtos_ItemSelected">

                <ListView.ItemTemplate>
                    <DataTemplate>

                        <ViewCell>

                            <Grid
                                Padding="10"
                                ColumnDefinitions="*,Auto"
                                RowDefinitions="Auto,Auto,Auto">

                                <!-- Descrição -->
                                <Label
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    FontAttributes="Bold"
                                    FontSize="18"
                                    Text="{Binding Descricao}" />

                                <!-- Quantidade -->
                                <Label
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    Text="{Binding Quantidade, StringFormat='Quantidade: {0:F2}'}" />

                                <!-- Preço -->
                                <Label
                                    Grid.Row="2"
                                    Grid.Column="0"
                                    Text="{Binding Preco, StringFormat='Preço: {0:C}'}" />

                                <!-- Total -->
                                <Label
                                    Grid.Row="0"
                                    Grid.RowSpan="3"
                                    Grid.Column="1"
                                    FontAttributes="Bold"
                                    FontSize="18"
                                    HorizontalOptions="End"
                                    VerticalOptions="Center"
                                    Text="{Binding Total, StringFormat='Total: {0:C}'}" />

                                <!-- Menu -->
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer />
                                </Grid.GestureRecognizers>

                                <Grid.ContextMenu>
                                    <MenuFlyout>

                                        <MenuFlyoutItem
                                            Text="Excluir"
                                            Clicked="MenuItem_Clicked" />

                                    </MenuFlyout>
                                </Grid.ContextMenu>

                            </Grid>

                        </ViewCell>

                    </DataTemplate>
                </ListView.ItemTemplate>

            </ListView>

        </RefreshView>

    </VerticalStackLayout>

</ContentPage>